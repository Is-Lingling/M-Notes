{
  "name": "markdownnotes-editor",
  "version": "1.0.6",
  "private": true,
  "description": "CodeMirror 6 bundle for MarkdownNotes editor",
  "scripts": {
    "build": "esbuild src/index.js --bundle --format=iife --global-name=CM --minify --outfile=../MarkdownNotes/Editor/codemirror/codemirror-bundle.js",
    "build:dev": "esbuild src/index.js --bundle --format=iife --global-name=CM --sourcemap --outfile=../MarkdownNotes/Editor/codemirror/codemirror-bundle.js",
    "test": "node tests/editor.cjs && node tests/interactions.cjs && node tests/selection.cjs && node tests/image-selection.cjs && node tests/line-numbers.cjs && node tests/diagram-math.cjs && node tests/memory.cjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.8.4",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "^1.63.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
