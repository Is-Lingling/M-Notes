{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "m-notes",
  "version": "1.0.0",
  "identifier": "com.markdownnotes.linux",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "M Notes",
        "width": 1050,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": ["txt"],
        "name": "Plain Text Document",
        "role": "Editor"
      }
    ]
  }
}
